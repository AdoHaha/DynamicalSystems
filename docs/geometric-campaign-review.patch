+def load_gap_ledger():
+    """Read the object schema expected by both gap commands, with useful errors."""
+    try:
+        data = json.loads(GAPS.read_text())
+    except (OSError, json.JSONDecodeError) as error:
+        raise ValueError(f"Invalid gap ledger {GAPS}: {error}") from error
+    prefix = f"Invalid gap ledger {GAPS}: "
+    if not isinstance(data, dict):
+        raise ValueError(prefix + "expected an object with a 'gaps' array, not a bare array")
+    if data.get("schema", 1) != 1:
+        raise ValueError(prefix + "unsupported schema (expected 1)")
+    if not isinstance(data.get("baseline", {}), dict):
+        raise ValueError(prefix + "'baseline' must be an object")
+    statuses = data.get("status_values", [])
+    if not isinstance(statuses, list) or any(not isinstance(s, str) or not s.strip()
+                                             for s in statuses):
+        raise ValueError(prefix + "'status_values' must be an array of nonempty strings")
+    if not isinstance(data.get("gaps"), list):
+        raise ValueError(prefix + "'gaps' must be an array (it may be empty)")
+    seen = set()
+    for index, gap in enumerate(data["gaps"]):
+        label = prefix + f"gaps[{index}]: "
+        if not isinstance(gap, dict):
+            raise ValueError(label + "expected an object")
+        for key in ("id", "status"):
+            if not isinstance(gap.get(key), str) or not gap[key].strip():
+                raise ValueError(label + f"'{key}' must be a nonempty string")
+        if gap["id"] in seen:
+            raise ValueError(label + f"duplicate id {gap['id']!r}")
+        seen.add(gap["id"])
+        for key in ("api", "resolution_task", "proposed_task", "next_step", "resolution"):
+            if gap.get(key) is not None and not isinstance(gap[key], str):
+                raise ValueError(label + f"'{key}' must be a string")
+        blocking = gap.get("blocking_tasks", [])
+        if not isinstance(blocking, list) or any(not isinstance(t, str) for t in blocking):
+            raise ValueError(label + "'blocking_tasks' must be an array of task ids")
+    return data
+
