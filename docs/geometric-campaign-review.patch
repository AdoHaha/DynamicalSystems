+"""Regression checks for geometric campaign ledgers, ownership and failure handling.
+
+No model, Lean installation, network or persistent campaign state is used.
+Run: python3 -m unittest discover -s automation/geometric_control -p 'test_*.py'
+"""
+from __future__ import annotations
+
+import contextlib
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+
+HERE = Path(__file__).resolve().parent
+RUNNER_PATH = HERE.parent / "campaign_runner.py"
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+with patch.dict(os.environ, {"CAMPAIGN_DIR": str(HERE)}):
+    runner = load_module("campaign_runner_under_test", RUNNER_PATH)
+supervisor = load_module("geometric_supervisor_under_test", HERE / "supervise.py")
+ralph = load_module("geometric_ralph_under_test", HERE / "ralph_loop.py")
+
+
+EMPTY_LEDGER = {"schema": 1, "baseline": {}, "status_values": [], "gaps": []}
+
+
+class GapLedgerTests(unittest.TestCase):
+    def run_cli(self, raw, *args):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder)
+            (path / "campaign.json").write_text(json.dumps({
+                "integration": "integration", "worktree": "worker", "audit_root": "Main"
+            }))
+            (path / "tasks.json").write_text('{"tasks": []}')
+            (path / "gaps.json").write_text(raw)
+            env = dict(os.environ, CAMPAIGN_DIR=str(path))
+            return subprocess.run([sys.executable, str(RUNNER_PATH), *args], env=env,
+                                  capture_output=True, text=True, check=False)
+
+    def test_valid_empty_object_supports_both_gap_commands(self):
+        for args in (("gaps",), ("gaps", "--harvest")):
+            with self.subTest(args=args):
+                result = self.run_cli(json.dumps(EMPTY_LEDGER), *args)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertIn("All gaps", result.stdout)
+
+    def test_original_bare_array_failure_is_actionable(self):
+        for args in (("gaps",), ("gaps", "--harvest"), ("run",)):
+            with self.subTest(args=args):
+                result = self.run_cli("[]", *args)
+                self.assertEqual(result.returncode, 1)
+                self.assertIn("expected an object", result.stderr)
+                self.assertNotIn("Traceback", result.stderr)
+
+    def test_empty_or_malformed_ledgers_fail_before_dispatch(self):
+        invalid = ["", "{", "{}", '{"gaps": {}}',
+                   json.dumps(dict(EMPTY_LEDGER, status_values="scheduled")),
+                   json.dumps(dict(EMPTY_LEDGER, gaps=["missing object"])),
+                   json.dumps(dict(EMPTY_LEDGER, gaps=[{"id": "gap"}])),
+                   json.dumps(dict(EMPTY_LEDGER, gaps=[{"id": "gap", "status": "proposed",
+                                                       "api": ["wrong type"]}]))]
+        for raw in invalid:
+            with self.subTest(raw=raw):
+                result = self.run_cli(raw, "run")
+                self.assertEqual(result.returncode, 1)
+                self.assertIn("Invalid gap ledger", result.stderr)
+                self.assertNotIn("Traceback", result.stderr)
+
+    def test_unresolved_gap_still_requires_next_step(self):
+        data = dict(EMPTY_LEDGER, status_values=["proposed"],
+                    gaps=[{"id": "chart", "status": "proposed"}])
+        result = self.run_cli(json.dumps(data), "gaps")
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("no next_step", result.stdout)
+
+    def test_campaign_ledger_and_manifest_validate(self):
+        with contextlib.redirect_stdout(io.StringIO()):
+            self.assertEqual(runner.report_gaps(), 0)
+            self.assertEqual(runner.validate_tasks(strict=True), 0)
+
+
+class LoopFailureTests(unittest.TestCase):
+    def test_supervisor_rejects_failed_ledger_before_dispatch(self):
+        with patch.object(supervisor, "call", return_value=7) as call, \
+                patch.object(supervisor, "status") as status, \
+                patch.object(sys, "argv", ["supervise.py"]), \
+                contextlib.redirect_stderr(io.StringIO()):
+            self.assertEqual(supervisor.main(), 7)
+            call.assert_called_once_with("gaps")
+            status.assert_not_called()
+
+    def test_ralph_rejects_failed_ledger_before_dispatch(self):
+        with patch.object(ralph, "run_campaign", return_value=7) as call, \
+                patch.object(ralph, "status") as status, \
+                patch.object(sys, "argv", ["ralph_loop.py"]), \
+                contextlib.redirect_stderr(io.StringIO()):
+            self.assertEqual(ralph.main(), 7)
+            call.assert_called_once_with("gaps")
+            status.assert_not_called()
+
+    def test_supervisor_propagates_harvest_failure_after_acceptance(self):
+        states = [{"chart": {"status": "ready"}}, {"chart": {"status": "needs_review"}}]
+        def command(*args):
+            return 9 if args == ("gaps", "--harvest") else 0
+        with patch.object(supervisor, "call", side_effect=command) as call, \
+                patch.object(supervisor, "status", side_effect=states), \
+                patch.object(sys, "argv", ["supervise.py", "--max-tasks", "2"]), \
+                contextlib.redirect_stdout(io.StringIO()), \
+                contextlib.redirect_stderr(io.StringIO()):
+            self.assertEqual(supervisor.main(), 9)
+            self.assertEqual(call.call_args.args, ("gaps", "--harvest"))
+            self.assertEqual(sum(c.args[0] == "run" for c in call.call_args_list), 1)
+
+    def test_ralph_propagates_harvest_failure_after_acceptance(self):
+        states = [{"tasks": {"chart": {"status": state}}}
+                  for state in ("ready", "needs_review", "needs_review")]
+        def command(*args):
+            return 9 if args == ("gaps", "--harvest") else 0
+        with patch.object(ralph, "run_campaign", side_effect=command) as call, \
+                patch.object(ralph, "status", side_effect=states), \
+                patch.object(ralph, "dependencies", return_value={"chart": []}), \
+                patch.object(sys, "argv", ["ralph_loop.py", "--auto-review"]), \
+                contextlib.redirect_stdout(io.StringIO()), \
+                contextlib.redirect_stderr(io.StringIO()):
+            self.assertEqual(ralph.main(), 9)
+            self.assertEqual(call.call_args.args, ("gaps", "--harvest"))
+            self.assertEqual(sum(c.args[0] == "run" for c in call.call_args_list), 1)
+
+
+class OwnedArtifactTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.work = Path(self.directory.name) / "worker"
+        self.work.mkdir()
+        self.integration = Path(self.directory.name) / "integration"
+        self.task = {
+            "id": "chart", "files": ["Main.lean"], "modules": ["Main", "Root"],
+            "support_files": ["Root.lean", "docs/note.md", "docs/extra.md"],
+            "required": ["mainResult"]
+        }
+        (self.work / "Main.lean").write_text("theorem mainResult : True := True.intro\n")
+        (self.work / "Root.lean").write_text("import Main\n")
+        self.addCleanup(patch.stopall)
+        patch.object(runner, "WORKTREE", self.work).start()
+        patch.object(runner, "INTEGRATION", self.integration).start()
+        patch.object(runner, "STATE", Path(self.directory.name) / "state.json").start()
+
+    def test_support_root_is_built_and_audited_without_scanning_docs_as_lean(self):
+        (self.work / "docs").mkdir()
+        (self.work / "docs/note.md").write_text("Review includes an axiom audit.\n")
+        commands, probes = [], []
+        def command(args, *unused, **kwargs):
+            commands.append(args)
+            if args[:3] == ["lake", "env", "lean"]:
+                probes.append(Path(args[3]).read_text())
+            return 0, "ok"
+        with patch.object(runner, "command", side_effect=command):
+            self.assertTrue(runner.check_task(self.task)[0])
+        self.assertIn(["lake", "build", "Root"], commands)
+        self.assertIn("import Root\n", probes[0])
+        audit = next(c for c in commands if c[:3] == ["lake", "exe", "axiom-audit"])
+        self.assertIn("Root", audit[audit.index("--modules") + 1].split(","))
+        lint = next(c for c in commands if c[:3] == ["lake", "lint", "--"])
+        self.assertIn("Root", lint)
+        self.assertIn("docs/note.md", runner.file_hashes(self.task))
+
+    def test_failed_exact_type_consumer_fails_the_gate(self):
+        (self.work / "docs").mkdir()
+        check = self.work / "docs/acceptance.lean"
+        check.write_text("import Main\nexample : False := mainResult\n")
+        task = dict(self.task, support_files=self.task["support_files"] +
+                    ["docs/acceptance.lean"], lean_checks=["docs/acceptance.lean"])
+        def command(args, *unused, **kwargs):
+            if args == ["lake", "env", "lean", str(check)]:
+                return 1, "type mismatch in exact acceptance contract"
+            return 0, "ok"
+        with patch.object(runner, "command", side_effect=command) as call:
+            passed, diagnostics = runner.check_task(task)
+        self.assertFalse(passed)
+        self.assertIn("type mismatch", diagnostics)
+        self.assertEqual(call.call_args.args[0], ["lake", "env", "lean", str(check)])
+
+    def test_missing_exact_type_consumer_is_not_silently_skipped(self):
+        task = dict(self.task, support_files=self.task["support_files"] +
+                    ["docs/acceptance.lean"], lean_checks=["docs/acceptance.lean"])
+        with patch.object(runner, "command", return_value=(0, "ok")):
+            passed, diagnostics = runner.check_task(task)
+        self.assertFalse(passed)
+        self.assertIn("Missing Lean acceptance check", diagnostics)
+
+    def git(self, *args, cwd=None):
+        result = subprocess.run(["git", *args], cwd=cwd or self.work,
+                                capture_output=True, text=True, check=False)
+        if result.returncode:
+            raise RuntimeError(result.stderr)
+        return result.stdout.strip()
+
+    def prepare_repositories(self):
+        self.git("init", "--initial-branch=worker")
+        self.git("config", "user.name", "Campaign test")
+        self.git("config", "user.email", "campaign-test@localhost")
+        self.git("add", "Main.lean", "Root.lean")
+        self.git("commit", "-m", "Baseline")
+        self.git("worktree", "add", "-b", "integration", str(self.integration))
+        (self.work / "Main.lean").write_text(
+            "theorem mainResult : True := True.intro\n-- Reviewed update.\n")
+        (self.work / "Root.lean").write_text("import Main\n-- Root integration.\n")
+        (self.work / "docs").mkdir()
+        (self.work / "docs/note.md").write_text("Reviewed support document.\n")
+        return {"tasks": {"chart": {
+            "status": "needs_review", "hashes": runner.file_hashes(self.task),
+            "base": self.git("rev-parse", "HEAD")
+        }}}
+
+    def test_acceptance_includes_support_without_staging_absent_support_paths(self):
+        state = self.prepare_repositories()
+        with patch.object(runner, "git", side_effect=self.git), \
+                patch.object(runner, "check_task", return_value=(True, "verified")), \
+                contextlib.redirect_stdout(io.StringIO()):
+            runner.review(self.task, state, SimpleNamespace(decision="accept", note="Reviewed"))
+        self.assertEqual(state["tasks"]["chart"]["status"], "accepted")
+        self.assertEqual((self.integration / "docs/note.md").read_text(),
+                         "Reviewed support document.\n")
+        self.assertIn("Root integration", (self.integration / "Root.lean").read_text())
+        self.assertFalse((self.integration / "docs/extra.md").exists())
+
+    def test_support_change_after_verification_requires_new_check(self):
+        state = self.prepare_repositories()
+        (self.work / "docs/note.md").write_text("Changed after review.\n")
+        with self.assertRaisesRegex(RuntimeError, "Files changed since verification"):
+            runner.review(self.task, state, SimpleNamespace(decision="accept", note="Reviewed"))
+
+    def test_support_scope_does_not_allow_unrelated_files(self):
+        state = self.prepare_repositories()
+        (self.work / "Outside.lean").write_text("theorem outside : True := True.intro\n")
+        with patch.object(runner, "git", side_effect=self.git), \
+                self.assertRaisesRegex(RuntimeError, "Out-of-scope changes"):
+            runner.review(self.task, state, SimpleNamespace(decision="accept", note="Reviewed"))
+
+
+if __name__ == "__main__":
+    unittest.main()
