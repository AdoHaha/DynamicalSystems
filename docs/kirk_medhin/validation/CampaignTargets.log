  (hopt : NeedleIntegralModel.IsIntegralOptimalPair prob x₀ x u) (DK : X →L[ℝ] ℝ)
  (hK : HasFDerivAt prob.K DK (x prob.T)) (xε : ι → ℝ → ℝ → X) (uε : ι → ℝ → ℝ → U)
  (hfeasible :
    ∀ (i : ι),
      ∀ᶠ (ε : ℝ) in nhdsWithin 0 (Set.Ioi 0), NeedleIntegralModel.IsIntegralAdmissiblePair prob x₀ (xε i ε) (uε i ε))
  (g : ι → ℝ × X)
  (htangent :
    ∀ (i : ι),
      Filter.Tendsto
        (fun ε =>
          ε⁻¹ •
            (KirkMedhin.K1.costAugmentedEndpoint prob (xε i ε) (uε i ε) - KirkMedhin.K1.costAugmentedEndpoint prob x u))
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (g i))) :
  ∃ q α,
    q ≠ 0 ∧
      0 < α ∧
        (∀ y ∈ KirkMedhin.K1.endpointVariationCone g, 0 ≤ q y) ∧
          q (1, 0) = α ∧ α⁻¹ • q = KirkMedhin.K1.terminalDifferential DK
