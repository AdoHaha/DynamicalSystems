  (u : ℝ → U) (τ : ℝ) (v : U) (r₀ : KirkMedhin.K1.BolzaBranchRegularity prob u)
  (rv : KirkMedhin.K1.BolzaBranchRegularity prob fun x => v) (hx : IsIntegralCurve x fun t z => prob.f t z (u t))
  (hinit : x 0 = x_init) (hu : ∀ t ∈ Set.Icc 0 prob.T, u t ∈ prob.controlSet) (hv : v ∈ prob.controlSet) (hτ₀ : 0 < τ)
  (hτ : τ ≤ prob.T) (DL : ℝ → X → X →L[ℝ] ℝ) (Df : ℝ → X → X →L[ℝ] X)
  (hDL : ∀ t ∈ Set.Icc 0 prob.T, ∀ (z : X), HasFDerivAt (fun y => prob.L t y (u t)) (DL t z) z)
  (hDf : ∀ t ∈ Set.Icc 0 prob.T, ∀ (z : X), HasFDerivAt (fun y => prob.f t y (u t)) (Df t z) z)
  (hDLc : ∀ t ∈ Set.Icc 0 prob.T, ContinuousAt (fun q => DL q.1 q.2) (t, x t))
  (hDfc : ∀ t ∈ Set.Icc 0 prob.T, ContinuousAt (fun q => Df q.1 q.2) (t, x t)) (Φ : ℝ → ℝ → ℝ × X →L[ℝ] ℝ × X)
  (hdiag : Φ prob.T prob.T = ContinuousLinearMap.id ℝ (ℝ × X))
  (hback :
    ∀ t ∈ Set.Icc 0 prob.T,
      HasDerivAt (fun s => Φ prob.T s)
        (-Φ prob.T t ∘SL KirkMedhin.K1.augmentedLinearCoefficient (DL t (x t)) (Df t (x t))) t) :
  ∃ xε,
    (∀ᶠ (ε : ℝ) in nhdsWithin 0 (Set.Ioi 0),
        NeedleIntegralModel.IsIntegralAdmissiblePair prob x_init (xε ε) (needleControl u τ v ε)) ∧
      Filter.Tendsto
        (fun ε =>
          ε⁻¹ •
            (KirkMedhin.K1.costAugmentedEndpoint prob (xε ε) (needleControl u τ v ε) -
              KirkMedhin.K1.costAugmentedEndpoint prob x u))
        (nhdsWithin 0 (Set.Ioi 0))
        (nhds ((Φ prob.T τ) (prob.L τ (x τ) v - prob.L τ (x τ) (u τ), prob.f τ (x τ) v - prob.f τ (x τ) (u τ))))
KirkMedhin.K1.integralOptimal_normal_covector_of_endpointTangents.{u_1, u_2, u_3} {X : Type u_1} {U : Type u_2}
