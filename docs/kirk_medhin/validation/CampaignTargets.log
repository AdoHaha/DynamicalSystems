      ∀ (p : ℝ × ℝ),
        (KirkMedhin.K3.parameterDerivative (firstVariation L K T x η) (firstVariation L K T x ξ)) p +
            lam *
              (KirkMedhin.K3.parameterDerivative (firstVariation G (fun x => 0) T x η)
                  (firstVariation G (fun x => 0) T x ξ))
