  (hK : ContDiff ℝ 1 K) (hx : ContDiff ℝ 1 x) (hη : ContDiff ℝ 1 η) (hξ : ContDiff ℝ 1 ξ) (hT : 0 ≤ T)
  (hΓ : ∀ (p : ℝ × ℝ), KirkMedhin.K3.perturbedCurve x η ξ p ∈ S)
  (hopt :
