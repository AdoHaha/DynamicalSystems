  (rtest : (v : U) → v ∈ prob.controlSet → KirkMedhin.K1.BolzaBranchRegularity prob fun x => v)
  (hx : IsIntegralCurve x fun t z => prob.f t z (u t)) (DL : ℝ → X → X →L[ℝ] ℝ) (Df : ℝ → X → X →L[ℝ] X)
  (hDL : ∀ t ∈ Set.Icc 0 prob.T, ∀ (z : X), HasFDerivAt (fun y => prob.L t y (u t)) (DL t z) z)
  (hDf : ∀ t ∈ Set.Icc 0 prob.T, ∀ (z : X), HasFDerivAt (fun y => prob.f t y (u t)) (Df t z) z)
  (hDLc : ∀ t ∈ Set.Icc 0 prob.T, ContinuousAt (fun q => DL q.1 q.2) (t, x t))
  (hDfc : ∀ t ∈ Set.Icc 0 prob.T, ContinuousAt (fun q => Df q.1 q.2) (t, x t)) (DK : X →L[ℝ] ℝ)
  (hK : HasFDerivAt prob.K DK (x prob.T)) :
  ∃ Φ q α,
    q ≠ 0 ∧
      0 < α ∧
        q (1, 0) = α ∧
          α⁻¹ • q = KirkMedhin.K1.terminalDifferential DK ∧
            (∀ y ∈ KirkMedhin.K1.endpointVariationCone (KirkMedhin.K1.needleEndpointGenerator prob x u Φ), 0 ≤ q y) ∧
              (∀ t ∈ Set.Icc 0 prob.T,
                  HasDerivAt (fun s => KirkMedhin.K1.propagatedStateCovector DK (Φ prob.T s))
                    (-(DL t (x t) + KirkMedhin.K1.propagatedStateCovector DK (Φ prob.T t) ∘SL Df t (x t))) t) ∧
                KirkMedhin.K1.propagatedStateCovector DK (Φ prob.T prob.T) = DK ∧
                  ∀ t ∈ Set.Icc 0 prob.T,
                    ∀ v ∈ prob.controlSet,
                      0 ≤
                        prob.L t (x t) v - prob.L t (x t) (u t) +
                          (KirkMedhin.K1.propagatedStateCovector DK (Φ prob.T t))
                            (prob.f t (x t) v - prob.f t (x t) (u t))
